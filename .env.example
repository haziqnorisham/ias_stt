FLASK_APP=run.py
FLASK_ENV=development
FLASK_PORT=5000

# Frontend (serves the /traps management UI). Set to false to return 404.
ENABLE_FRONTEND=true

# Application timezone for API timestamps, UI dates, and application logs.
# Data is stored in UTC and displayed in this timezone. Use an IANA name.
APP_TIMEZONE=Asia/Kuala_Lumpur

# Security: legacy service API key for integrations such as telemetry ingestion.
# Browser/API users authenticate with local users and JWTs.
API_KEY=
# Comma-separated permissions granted to the legacy API key. Use '*' for full
# compatibility access, or scope it for a specific integration.
API_KEY_PERMISSIONS=*
# Stable JWT signing secret. Required in production; use a long random value.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Set to the number of trusted reverse-proxy hops when TLS terminates upstream.
# Only configure this when Flask is reachable exclusively through that proxy.
TRUSTED_PROXY_HOPS=0

# LDAP authentication is disabled by default. Configure one directory per
# deployment; LLDAP and Active Directory use the same adapter with mappings.
LDAP_ENABLED=false
# Keep this value stable for the lifetime of provisioned LDAP accounts.
LDAP_DIRECTORY_KEY=primary
LDAP_DIRECTORY_TYPE=lldap
# Use ldaps:// or ldap:// with LDAP_STARTTLS=true. Production must validate TLS.
LDAP_SERVER_URI=ldaps://ldap.example.test:636
LDAP_STARTTLS=false
# Development/tests only; never enable plaintext LDAP in production.
LDAP_ALLOW_INSECURE=false
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=cn=readonly,ou=people,dc=example,dc=test
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=ou=people,dc=example,dc=test
LDAP_USER_FILTER=(objectClass=person)
# Set the subject attribute to the verified stable ID provided by your LDAP.
# For AD, use objectGUID; verify the stable UUID attribute exposed by your LLDAP.
LDAP_SUBJECT_ATTRIBUTE=
LDAP_USERNAME_ATTRIBUTE=uid
# AD deployments may set this to sAMAccountName,userPrincipalName.
LDAP_LOGIN_ATTRIBUTES=uid
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
LDAP_EMAIL_ATTRIBUTE=mail
# Optionally map an enabled/disabled attribute (e.g. LLDAP userEnabled).
# AD userAccountControl disabled bit and accountExpires are checked automatically.
LDAP_ENABLED_ATTRIBUTE=
LDAP_ENABLED_VALUES=true,1,yes
LDAP_CONNECT_TIMEOUT=5
LDAP_RECEIVE_TIMEOUT=5
LDAP_SEARCH_LIMIT=200

# Database (SQLite). Override to use another engine; defaults to data/traps.db
# DATABASE_URL=sqlite:///data/traps.db

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mqtt_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# MQTT (disabled by default: telemetry is ingested via HTTP
# POST /api/telemetry/ingest from ChirpStack's HTTP integration.
# Set to true to re-enable the MQTT listener.)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Comma-separated topics. '+' matches exactly ONE level, '#' matches the rest.
# The pattern must have the same number of levels as the published topic, e.g.
# ChirpStack v4 publishes application/<id>/device/<devEUI>/event/<type>, so use
# application/<id>/device/+/event/+  (NOT .../device/+/event which is one level short)
MQTT_TOPICS=topic1,topic2
MQTT_CLIENT_ID=flask_service_001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Processing
BATCH_SIZE=100
PROCESSING_INTERVAL=5

# uWSGI (Docker / production)
UWSGI_PROCESSES=2
UWSGI_THREADS=2
